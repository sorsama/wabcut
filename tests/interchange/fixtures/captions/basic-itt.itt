<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xml:lang="en" ttp:timeBase="smpte" ttp:frameRate="30" ttp:frameRateMultiplier="1000 1001" ttp:dropMode="dropNTSC">
  <head>
    <metadata>
      <ttm:title>Sample</ttm:title>
    </metadata>
    <styling>
      <style xml:id="normal" tts:fontFamily="sansSerif" tts:fontWeight="normal" tts:fontStyle="normal" tts:color="white" tts:fontSize="100%"/>
    </styling>
    <layout>
      <region xml:id="top" tts:origin="10% 10%" tts:extent="80% 20%" tts:textAlign="center" tts:displayAlign="before"/>
      <region xml:id="bottom" tts:origin="10% 70%" tts:extent="80% 20%" tts:textAlign="center" tts:displayAlign="after"/>
    </layout>
  </head>
  <body style="normal" region="bottom">
    <div>
      <p begin="01:00:01:00" end="01:00:03:00">Hello there.</p>
      <p begin="01:00:04:00" end="01:00:07:00">Second caption,<br/>two lines.</p>
      <p begin="01:00:08:00" end="01:00:10:00">Café ♪ ¿ Qué pasó?</p>
      <p begin="01:00:11:00" end="01:00:12:00">&lt;Tags&gt; &amp; &quot;quotes&quot;</p>
    </div>
  </body>
</tt>

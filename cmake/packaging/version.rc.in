// Version information of @WABCUT_RC_FILENAME@ (Explorer > Properties > Details, installers, crash dumps).
// Generated by wabcut_add_version_resource() in cmake/WabcutInstall.cmake; do not edit the generated copy.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @WABCUT_RC_VERSION_COMMAS@
 PRODUCTVERSION @WABCUT_RC_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS @WABCUT_RC_FILEFLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Wabcut contributors"
            VALUE "FileDescription", "@WABCUT_RC_DESCRIPTION@"
            VALUE "FileVersion", "@WABCUT_RC_VERSION_DOTS@"
            VALUE "InternalName", "@WABCUT_RC_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (C) Wabcut contributors. GNU GPL version 3 or later."
            VALUE "OriginalFilename", "@WABCUT_RC_FILENAME@"
            VALUE "ProductName", "Wabcut"
            VALUE "ProductVersion", "@WABCUT_RC_PRODUCT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

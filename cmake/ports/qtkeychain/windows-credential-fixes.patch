+    explicit CredentialDeleter(PCREDENTIALW &cred) : m_cred(cred) { }
     ~CredentialDeleter() {
         if (m_cred) {
             CredFree(m_cred);
         }
     }
 
-    PCREDENTIALW m_cred;
+    PCREDENTIALW &m_cred;
 };
 

    def createSequence(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        anchor: list[float] = ...,
        aspect: str = ...,
        fit: Literal["crop", "letterbox", "blur"] = ...,
        height: int = ...,
        margin: float = ...,
        mode: Literal["follow", "faces", "speaker", "anchor"] = ...,
        name: str = ...,
        preview: bool = ...,
        sequence: int = ...,
        smoothness: float = ...,
        width: int = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Auto Reframe

        Makes a copy of a sequence at another aspect ("9:16" for vertical shorts, "1:1", "4:5", "16:9") whose video clips keep their subjects in frame: per shot, a smooth virtual camera (still, then steady pans) follows the main subject, all faces, the speaker or an anchor. The result is ordinary, editable Position/Scale keyframes on each clip (nothing is rendered); the source sequence is not changed. Run analysis.subjects first for long media (otherwise this runs it). The new sequence remembers its source, so reframe.rerun can make it again.

        Command ``reframe.createSequence`` (needs EditProject; runs an AI model, so MediaAnalysis is needed too).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            anchor: Anchor mode: the point to keep centred, [x, y] in 0..1 of the picture.
            aspect: Aspect of the new sequence: "9:16" (vertical), "1:1", "4:5", "16:9" or any "W:H". Default "9:16".
            fit: Where the subjects cannot fit: "crop" anyway (default), zoom out with "letterbox" bars, or zoom out over a "blur"red fill.
            height: Output height in pixels (with width).
            margin: Room kept around a subject, as a fraction of the frame. Default 0.04.
            mode: What the frame follows: "follow" the main subject of each shot (default), keep all "faces" in, the "speaker" who is talking, or a fixed "anchor" point.
            name: Name of the new sequence. Default: the source's name and the aspect.
            preview: Report the frame path of each clip for drawing (default true). (Default: True.)
            sequence: The sequence to reframe; only needed when the project has several.
            smoothness: 0 = follow closely .. 1 = move only when needed. Default 0.5.
            width: Output width in pixels (with height). Default: the source's short side kept.
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """


        at: int | str = ...,
        cloneVoice: bool = ...,
        duck: float = ...,
        estimate: bool = ...,
        gap: float = ...,
        language: str = ...,
        maxCost: float = ...,
        maxStretch: float = ...,
        model: str = ...,
        name: str = ...,
        onBeats: bool = ...,
        rightsConfirmed: bool = ...,
        sequence: int = ...,
        speaker: int = ...,
        style: str = ...,
        voice: str = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Narration

        Narration from a script with the user's own voice provider (BYOK): each line spoken, over its rough-cut beat when the sequence is a rough cut (AI-11) or one after another, on a new "Narration" audio track with the Dialogue role and the other audio ducked under it, as one undo step. The audio is marked AI-generated. Paid: "estimate" prices it; a run needs "maxCost" and the app's approval.

        Command ``narration.create`` (needs EditProject; runs an AI model, so MediaAnalysis is needed too).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            text: The script: one line per beat (Markdown headings, bullets and [B-roll] cues are dropped). (Required.)
            at: Where the first line starts when not on beats (default the sequence's start). Timecode in the sequence's rate ("00:01:02:03") or ticks.
            cloneVoice: Clone the speaker's own voice (ElevenLabs instant cloning) instead of a stock voice. Opt-in; needs rightsConfirmed and speaker; never for a speaker with redacted speech. The clone is deleted after the run. (Default: False.)
            duck: How far the other audio goes down under the narration, dB (default -12; 0 = not at all).
            estimate: Only plan and price the run; nothing is sent or changed (default false). (Default: False.)
            gap: Seconds between lines when not on beats (default 0.5).
            language: The language spoken (ISO 639-1); dub default: the caption track's.
            maxCost: The run's hard cap in USD: refused before anything is sent when it could cost more, stopped before a line that could pass it. Required for a run.
            maxStretch: How much faster a line may be played to fit (0.15 = 15 %, the default; pitch kept).
            model: Voice model (registry id): eleven_v3 / eleven_v4 (Thai and 70+ languages), eleven_flash_v2_5, gpt-4o-mini-tts, gemini-3.8-flash-tts. Default: the host's, else eleven_v3.
            name: The new audio track's name.
            onBeats: On a rough cut (roughcut.fromScript), line i over beat i when the counts match (default true). (Default: True.)
            rightsConfirmed: The user confirmed: "I have the speaker's permission" to clone their voice. (Default: False.)
            sequence: Sequence id; only needed when the project has several.
            speaker: The project speaker whose voice is cloned.
            style: Delivery instructions ("warm, unhurried"), where the model takes them.
            voice: The model's voice (an ElevenLabs voice id, an OpenAI voice such as "marin", a Gemini voice such as "Kore"); default: the model's first.
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """


class OgrafCommands:

    def import_(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        path: str,
        at: int | str = ...,
        duration: int | str = ...,
        manifest: str = ...,
        placement: Literal["targeted", "freeTrackAtOrAbove", "newTrack"] = ...,
        saveAs: OgrafImport_SaveAs = ...,
        sequence: int = ...,
        track: str | int = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Import OGraf

        Imports an OGraf graphic (the EBU's open HTML graphics format) as a motion graphic template. OGraf graphics are drawn by web pages with scripts; Wabcut has no web engine and runs no scripts, so it imports a package that also ships a Lottie version of the graphic (one .json or .lottie animation in the package, or the one the manifest names in "v_wabcut_lottie"). The manifest's fields (title, name) name the template fields whose Lottie layers are called alike. "path" is the manifest (*.ograf.json: its folder is the package), a package folder or a .zip package. A package without a Lottie version fails with a message that says so (ograf.inspect lists its fields). With "at" it becomes a clip there (an instance of the template: Essential Graphics edits and keys its fields); with "saveAs" a template in the project's library.

        Command ``ograf.import`` (needs EditProject; reads or writes files its parameters name).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            path: The manifest (*.ograf.json), a package folder or a .zip package (UTF-8 path). (Required.)
            at: Place it as a clip starting here. Timecode in the sequence's rate ("00:01:02:03") or ticks.
            duration: The clip's length (default the animation's). Timecode in the sequence's rate ("00:01:02:03") or ticks.
            manifest: Which graphic of a package that holds several: its manifest's path inside the package.
            placement: "targeted": on "track" (or the targeted video track), overwriting what is there; the default when "track" is given. "freeTrackAtOrAbove": the first unlocked video track from "track" (or the targeted one) upwards with nothing in the graphic's time range, a new top track when none is free; the default without "track", so nothing under the playhead is overwritten. "newTrack": a new video track on top.
            saveAs: (no description)
            sequence: Sequence id; only needed when the project has several.
            track: A video track. Default: the first targeted unlocked video track. "V1" (bottom video track), "A2", ... or a track id.
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """

    def inspect(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        path: str,
        manifest: str = ...,
        sequence: int = ...,
    ) -> Any:
        """Inspect OGraf

        Reads an OGraf package's manifest without importing it: its name, id, author, the fields (title, type, default) and the custom actions it declares, the script that draws it (never run) and whether Wabcut can draw it - only a package with a Lottie version can be (ograf.import); "why" says what is missing otherwise.

        Command ``ograf.inspect`` (needs Read; reads or writes files its parameters name).
        Returns the command's answer (the data of the read).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            path: The manifest (*.ograf.json), a package folder or a .zip package (UTF-8 path). (Required.)
            manifest: Which graphic of a package that holds several: its manifest's path.
            sequence: Sequence id; only needed when the project has several.
        """



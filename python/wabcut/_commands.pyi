class AdjustmentCommands:

    def add(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        at: int | str,
        duration: int | str = ...,
        media: int | str = ...,
        placement: Literal["targeted", "freeTrackAtOrAbove", "newTrack"] = ...,
        sequence: int = ...,
        track: str | int = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """New Adjustment Layer

        Adds an adjustment layer clip (File > New > Adjustment Layer, dropped on the timeline): its effects (colour grade, blur, masks, keyframes) apply to the composite of every video track below it for its duration; its Opacity and blend mode mix the adjusted picture over the unadjusted one. Inside a nested sequence it adjusts that sequence's lower tracks only. "media" reuses an existing adjustment layer item; without it a new one is made for the sequence. Add effects with clip.addEffect. createdIds: the clip (and the new item).

        Command ``adjustment.add`` (needs EditSequence).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            at: Where it starts. Timecode in the sequence's rate ("00:01:02:03") or ticks. (Required.)
            duration: How long it lasts. Default 5 seconds. Timecode in the sequence's rate ("00:01:02:03") or ticks.
            media: An existing adjustment layer item to reuse. A media id or exact name.
            placement: "targeted" (default): on "track", overwriting what is there. "freeTrackAtOrAbove": the first unlocked video track from "track" upwards that is free over its range. "newTrack": a new video track on top.
            sequence: Sequence id; only needed when the project has several.
            track: A video track. Default: the first targeted unlocked video track. "V1" (bottom video track), "A2", ... or a track id.
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """


class AnalysisCommands:

    def detectBeats(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        beatsPerBar: int = ...,
        clip: int | AnalysisDetectBeats_Clip = ...,
        grid: bool = ...,
        markers: Literal["all", "downbeats", "none"] = ...,
        maxBpm: float = ...,
        media: int | str = ...,
        minBpm: float = ...,
        sequence: int = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Detect Beats

        Finds the tempo and beats of a clip's music: beat markers labelled 1-2-3-4 (downbeats red) and the sequence's beat grid (snapping, edit.snapToBeats and edit.cutToBeats use it). For a media item the beats are listed in media time. Results are cached per source file.

        Command ``analysis.detectBeats`` (needs EditSequence).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            beatsPerBar: Default 4.
            clip: The music clip. A clip id, or {"track", "time"} for the clip there.
            grid: Set the sequence's beat grid from the beats. Default true. (Default: True.)
            markers: Which beats get markers. Default all.
            maxBpm: Fastest tempo to consider. Default 200.
            media: Or a media item. A media id or exact name.
            minBpm: Slowest tempo to consider. Default 60.
            sequence: Sequence id; only needed when the project has several.
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """

    def detectShots(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        clip: int | AnalysisDetectShots_Clip = ...,
        detector: Literal["combined", "content", "adaptive", "threshold"] = ...,
        markers: bool = ...,
        media: int | str = ...,
        sequence: int = ...,
        threshold: float = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Detect Shots

        Finds the cuts (hard cuts, fades through black, dissolves; flashes are not cuts) in a clip's video and, for a clip, marks them with sequence markers ("markers": false to only list them). For a media item the cuts are listed in media time. Results are cached per source file.

        Command ``analysis.detectShots`` (needs EditSequence).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            clip: The clip. A clip id, or {"track", "time"} for the clip there.
            detector: Detector: combined (hard cuts, fades, dissolves; flashes ignored; default), content, adaptive or threshold (fades through black).
            markers: Add a marker at each cut in the clip. Default true. (Default: True.)
            media: Or a media item. A media id or exact name.
            sequence: Sequence id; only needed when the project has several.
            threshold: Content threshold (default 27; lower finds more cuts).
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """

    def speakers(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        angles: list[AnalysisSpeakers_AnglesItem] = ...,
        clip: int = ...,
        faces: bool = ...,
        multicam: int = ...,
        segments: int = ...,
        sequence: int = ...,
    ) -> Any:
        """Who Speaks When

        Active-speaker detection for a multicam source, on this computer: who speaks when (with crosstalk, silence and laughter) and which angle shows whom (close-up or wide), from the transcripts with their speakers, each angle's microphone level and each camera's faces and lip motion. Nothing changes. "angles" sets angles yourself; they win over the guesses.

        Command ``analysis.speakers`` (needs MediaAnalysis; runs an AI model, so MediaAnalysis is needed too).
        Returns the command's answer (the data of the read).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            angles: Your angle assignments; they win over the guesses.
            clip: A multicam clip of the sequence (default: its first).
            faces: Look at the cameras' faces (default true; false is quicker on long recordings: the angles' roles then come from your assignments and the microphones).
            multicam: Or the multicam source sequence itself.
            segments: At most this many segments listed (default 400).
            sequence: Sequence id; only needed when the project has several.
        """

    def subjects(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        media: int | str,
        stream: int = ...,
    ) -> Any:
        """Find Subjects

        Finds the faces, people and salient regions of a media item over time, shot by shot (5-10 samples a second, denser while the picture moves; faces and people tracked within each shot). Reframing uses it; the result is cached per file, so running it again is cheap. Runs locally: nothing leaves the computer.

        Command ``analysis.subjects`` (needs MediaAnalysis; runs an AI model, so MediaAnalysis is needed too).
        Returns the command's answer (the data of the read).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            media: Media id or exact name. (Required.)
            stream: Video stream index (default 0).
        """



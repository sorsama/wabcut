class TransitionCommands:

    def add(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        clip: int | TransitionAdd_Clip,
        edge: Literal["head", "tail"],
        alignment: Literal["center", "startAtCut", "endAtCut", "custom"] = ...,
        duration: int | str = ...,
        effect: Literal["crossDissolve", "additiveDissolve", "dipToBlack", "dipToColor", "dipToWhite", "filmDissolve", "nonAdditiveDissolve", "irisBox", "irisCross", "irisDiamond", "irisRound", "pagePeel", "pageTurn", "bandSlide", "centerSplit", "push", "slide", "split", "whip", "bandWipe", "barnDoors", "checkerWipe", "checkerBoard", "clockWipe", "gradientWipe", "inset", "paintSplatter", "pinwheel", "radialWipe", "randomBlocks", "randomWipe", "spiralBoxes", "venetianBlinds", "wedgeWipe", "wipe", "zigZagBlocks", "crossZoom", "zoomBlur", "lightLeak", "flash", "glitch", "animationBlock", "animationFade", "animationFlip", "animationFold", "animationPop", "animationPull", "animationSpin", "animationSpring", "animationTravel", "animationSurprise", "morphCut", "constantPower", "constantGain", "exponentialFade"] = ...,
        fit: Literal["exact", "availableHandles"] = ...,
        offset: int | str = ...,
        params: dict[str, Any] = ...,
        sequence: int = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Add Transition

        Adds a transition at a clip's head or tail: on the cut when the neighbouring clip meets that edge, otherwise inside the clip (a fade from/to black). The media must have frames beyond the cut; by default the transition is shortened to what there is. Default effect: crossDissolve on video, constantPower on audio.

        Command ``transition.add`` (needs EditSequence).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            clip: The clip. A clip id, or {"track", "time"} for the clip there. (Required.)
            edge: Which edge: "head" (the clip's In point) or "tail" (its Out point). (Required.)
            alignment: Where the transition sits on a cut between two clips: centered (default), starting at the cut (the outgoing clip plays on), ending at it, or custom: the cut lies "offset" into it (by default where it is now). Stored on the transition: a new duration keeps it. Ignored for a one-sided transition at a clip end with no neighbour.
            duration: Transition length. Default 1 second. Timecode in the sequence's rate ("00:01:02:03") or ticks.
            effect: The transition (effect.list).
            fit: When the media lacks frames beyond the cut: "exact" fails with how much there is, "availableHandles" shortens the transition to fit (default).
            offset: With alignment "custom": how much of the transition lies before the cut. Timecode in the sequence's rate ("00:01:02:03") or ticks.
            params: Constant parameters, e.g. a wipe's {"angle": 90}.
            sequence: Sequence id; only needed when the project has several.
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """

    def remove(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        transition: int,
        sequence: int = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Remove Transition

        Deletes a transition; the edit point becomes a cut.

        Command ``transition.remove`` (needs EditSequence).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            transition: Transition id. (Required.)
            sequence: Sequence id; only needed when the project has several.
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """

    def set(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        transition: int,
        after: int | str = ...,
        alignment: Literal["center", "startAtCut", "endAtCut", "custom"] = ...,
        before: int | str = ...,
        duration: int | str = ...,
        effect: Literal["crossDissolve", "additiveDissolve", "dipToBlack", "dipToColor", "dipToWhite", "filmDissolve", "nonAdditiveDissolve", "irisBox", "irisCross", "irisDiamond", "irisRound", "pagePeel", "pageTurn", "bandSlide", "centerSplit", "push", "slide", "split", "whip", "bandWipe", "barnDoors", "checkerWipe", "checkerBoard", "clockWipe", "gradientWipe", "inset", "paintSplatter", "pinwheel", "radialWipe", "randomBlocks", "randomWipe", "spiralBoxes", "venetianBlinds", "wedgeWipe", "wipe", "zigZagBlocks", "crossZoom", "zoomBlur", "lightLeak", "flash", "glitch", "animationBlock", "animationFade", "animationFlip", "animationFold", "animationPop", "animationPull", "animationSpin", "animationSpring", "animationTravel", "animationSurprise", "morphCut", "constantPower", "constantGain", "exponentialFade"] = ...,
        fit: Literal["exact", "availableHandles"] = ...,
        offset: int | str = ...,
        params: dict[str, Any] = ...,
        sequence: int = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Set Transition

        Changes a transition: its effect, parameters, its length on either side of the cut ("before", "after"), a new total "duration" placed by its alignment, or the alignment itself (which re-splits it; "custom" with "offset" puts the cut that far in).

        Command ``transition.set`` (needs EditSequence).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            transition: Transition id (sequence.summary and clip.details list them). (Required.)
            after: New length after the cut. Timecode in the sequence's rate ("00:01:02:03") or ticks.
            alignment: Where the transition sits on a cut between two clips: centered (default), starting at the cut (the outgoing clip plays on), ending at it, or custom: the cut lies "offset" into it (by default where it is now). Stored on the transition: a new duration keeps it. Ignored for a one-sided transition at a clip end with no neighbour.
            before: New length before the cut. Timecode in the sequence's rate ("00:01:02:03") or ticks.
            duration: New total length, split by alignment. Timecode in the sequence's rate ("00:01:02:03") or ticks.
            effect: New transition effect.
            fit: When the media lacks frames beyond the cut: "exact" fails with how much there is, "availableHandles" shortens the transition to fit (default).
            offset: With alignment "custom": how much of the transition lies before the cut. Timecode in the sequence's rate ("00:01:02:03") or ticks.
            params: New constant parameters (replace all).
            sequence: Sequence id; only needed when the project has several.
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """


class VrCommands:

    def info(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        media: int | str = ...,
        sequence: int = ...,
    ) -> Any:
        """VR Video Info

        Whether the sequence is VR / 360 video (its projection and eye layout: sequence.setSettings "vr" sets it) and, with "media", what that item's picture is: "file" is what its spherical metadata says, "interpretation" Interpret Footage's setting (null: none), "effective" the one in use and "suits" whether the frame size fits the projection (a 360 eye is 2:1, a 180 eye 1:1).

        Command ``vr.info`` (needs Read).
        Returns the command's answer (the data of the read).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            media: A media item. A media id or exact name.
            sequence: Sequence id; only needed when the project has several.
        """

    def reorient(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        clips: list[int | VrReorient_ClipsItem],
        pitch: float = ...,
        projection: Literal["equirect360", "equirect180"] = ...,
        roll: float = ...,
        sequence: int = ...,
        stereo: Literal["mono", "topBottom", "sideBySide"] = ...,
        yaw: float = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """VR Reorient

        Adds the VR Reorient effect to 360 / VR180 clips and sets it: "yaw" turns the sphere to the right, "pitch" up, "roll" tilts it to the right (degrees; keyframe them with clip.addKeyframe), so a different part of the scene lands straight ahead. The projection and eye layout default to the clip's (its footage's, else the sequence's); a flat clip needs "projection". One undo step.

        Command ``vr.reorient`` (needs EditSequence).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            clips: 360 / VR180 clips. (Required.)
            pitch: Degrees up (-90 to 90).
            projection: The picture's projection. Default: the clip's.
            roll: Degrees of tilt to the right (-3600 to 3600).
            sequence: Sequence id; only needed when the project has several.
            stereo: The picture's eye layout. Default: the clip's.
            yaw: Degrees to the right (-3600 to 3600).
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """


class WorkflowCommands:

    def podcast(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        angles: list[WorkflowPodcast_AnglesItem] = ...,
        cameras: list[int | str] = ...,
        captionPreset: str = ...,
        context: WorkflowPodcast_Context = ...,
        enhanceStrength: float = ...,
        fillers: bool = ...,
        lufs: float = ...,
        maxChapters: int = ...,
        media: list[int | str] = ...,
        mics: list[int | str] = ...,
        minChapterSeconds: float = ...,
        name: str = ...,
        run: bool = ...,
        shorts: bool = ...,
        shortsCount: int = ...,
        silences: float = ...,
        skip: list[Literal["multicam", "sequence", "transcribe", "enhance", "loudness", "cleanup", "autoswitch", "captions", "chapters", "shorts"]] = ...,
        steps: list[Literal["multicam", "sequence", "transcribe", "enhance", "loudness", "cleanup", "autoswitch", "captions", "chapters", "shorts"]] = ...,
        switchPreset: Literal["calm", "interview", "energetic"] = ...,
        sync: Literal["audio", "timecode", "inPoints", "outPoints", "markers"] = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Podcast Workflow

        The one-click podcast / interview edit, on this computer (local, free): sync the cameras and microphones (multicam by audio), lay out the episode (the multicam picture, each microphone on its own dialogue track), transcribe, Enhance Speech, loudness to -16 LUFS, remove fillers and long pauses, switch cameras to whoever speaks, captions, chapters from the topics (and YouTube chapters), optionally shorts. Without "run" it returns the plan (every step, on or off and why); with "run" it runs the enabled steps (or "steps"), as one undo step; "context" continues an earlier run.

        Command ``workflow.podcast`` (needs EditProject; runs an AI model, so MediaAnalysis is needed too).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            angles: Who is on which camera, for the switching (default: the analysis guesses).
            cameras: The camera recordings (the picture angles).
            captionPreset: The caption preset (default Podcast).
            context: What earlier runs made (a previous result's "context", as it is).
            enhanceStrength: Enhance Speech strength 0..100 (default 70).
            fillers: Remove filler words (default true).
            lufs: Loudness target (default -16, podcasts).
            maxChapters: At most this many chapters (default 12).
            media: Or all recordings: those with a picture are cameras, the rest microphones.
            mics: The microphone recordings (audio only). Default: the cameras' own sound.
            minChapterSeconds: A chapter lasts at least this long (default 60 s).
            name: The episode's name (default Podcast).
            run: Run the steps (default false: return the plan only).
            shorts: Also make vertical shorts of the best moments (default false).
            shortsCount: How many shorts (default 3).
            silences: Shorten pauses longer than this many seconds (default 1; 0 keeps pauses).
            skip: Steps to leave out.
            steps: Run only these steps (with "run").
            switchPreset: The camera switching preset (default calm).
            sync: How the recordings are synced (default audio).
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """



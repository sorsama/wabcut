class ShortsCommands:

    def create(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        shorts: list[ShortsCreate_ShortsItem],
        aspect: str = ...,
        captionPreset: str = ...,
        captions: bool = ...,
        cleanup: bool = ...,
        cleanupSilences: float = ...,
        fit: Literal["crop", "letterbox", "blur"] = ...,
        hookTitle: bool = ...,
        mode: Literal["follow", "faces", "speaker", "anchor"] = ...,
        normalize: bool = ...,
        reframe: bool = ...,
        sequence: int = ...,
        titleSeconds: float = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Create Shorts

        Makes one new sequence per short (from shorts.find): the range cut out of the source sequence, reframed to 9:16 (or "aspect") with editable keyframes following the speaker, captioned (vertical shorts in the "Shorts" caption style unless "captionPreset" says otherwise), with the title as a hook for its first seconds; optionally cleaned of fillers and silences and normalised to -14 LUFS. The source is not changed; all the shorts of one call are one undo step. Export them afterwards (vertical 1080x1920).

        Command ``shorts.create`` (needs EditProject; runs an AI model, so MediaAnalysis is needed too).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            shorts: The shorts to make (from shorts.find), at most 10. (Required.)
            aspect: Aspect of the shorts (default "9:16").
            captionPreset: The caption style: a built-in preset (Shorts, Clean, Bold Box, Podcast, Thai-friendly) or one of the project's. Default "Shorts" for vertical output, none (the default look) otherwise; "" = the default look.
            captions: Add captions from the transcript (default true). (Default: True.)
            cleanup: Remove fillers and silences first (default false). (Default: False.)
            cleanupSilences: With cleanup: the shortest pause removed, in seconds (default 0.8).
            fit: Where subjects cannot fit (default "crop").
            hookTitle: Show the title for the first seconds (default true). (Default: True.)
            mode: What the frame follows (default "speaker").
            normalize: Normalise the loudness to -14 LUFS (default false). (Default: False.)
            reframe: Reframe to the aspect (default true). (Default: True.)
            sequence: The source sequence; only needed when the project has several.
            titleSeconds: How long the hook title shows (default 3).
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """

    def find(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        analyze: bool = ...,
        count: int = ...,
        maxDuration: float = ...,
        minDuration: float = ...,
        query: str = ...,
        rerank: bool = ...,
        sequence: int = ...,
        targetDuration: float = ...,
    ) -> Any:
        """Find Shorts

        Finds the best moments of a long sequence for vertical shorts (20-90 s each): whole sentences, a hook in the first seconds, one topic, lively delivery, faces, few fillers; optionally about a topic ("query"). Returns them best first with a score breakdown, reasons, a suggested title, the words and a start/end (seconds; ticks too) snapped to sentences and cuts, ready for shorts.create. Needs the media's transcripts. A read: it changes nothing.

        Command ``shorts.find`` (needs Read; runs an AI model, so MediaAnalysis is needed too).
        Returns the command's answer (the data of the read).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            analyze: Analyse faces and motion of media not analysed yet (slow for long media; default false: cached analyses only). (Default: False.)
            count: How many shorts (default 5).
            maxDuration: Longest short in seconds (default 90).
            minDuration: Shortest short in seconds (default 20).
            query: What the shorts should be about, e.g. "the pricing discussion".
            rerank: Also let the user's cloud chat model rank and title the best ones from their transcript text (needs consent; never for a no-cloud project; default false). (Default: False.)
            sequence: The sequence to search (a podcast, an interview); only needed when the project has several.
            targetDuration: Preferred length in seconds (default 45).
        """



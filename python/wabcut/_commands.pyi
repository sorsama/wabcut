        limit: int = ...,
        maxGap: float = ...,
        meaning: bool = ...,
        media: list[int | str] = ...,
        minSimilarity: float = ...,
        sequence: int = ...,
    ) -> Any:
        """Find Takes

        Finds repeated attempts of the same line (retakes and false starts) in a sequence and the recordings it uses: groups of takes, best first, each with its words, a word-by-word difference from the best one, and quality (fillers, false starts, pauses, complete sentence, level, clipping, noise floor, pace). "improvable" groups would change with takes.use best. Needs transcripts. A read: it changes nothing.

        Command ``takes.find`` (needs Read; runs an AI model, so MediaAnalysis is needed too).
        Returns the command's answer (the data of the read).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            acrossRecordings: Attempts in different recordings count (default true). (Default: True.)
            includeSourceMedia: Also look in the whole recordings the sequence uses, for takes trimmed away (default true). (Default: True.)
            limit: Groups listed at most (default 100).
            maxGap: Within one recording, attempts further apart than this (seconds) are not retakes (default 180).
            meaning: Also group paraphrased attempts by meaning with the text encoder (slower; default false). (Default: False.)
            media: More media items whose transcripts hold takes.
            minSimilarity: How alike two attempts must be to count as takes of one line, 0.3..1 (default 0.7).
            sequence: The sequence; only needed when the project has several.
        """

    def use(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        acrossRecordings: bool = ...,
        best: bool = ...,
        group: int = ...,
        includeSourceMedia: bool = ...,
        maxGap: float = ...,
        meaning: bool = ...,
        media: list[int | str] = ...,
        minSimilarity: float = ...,
        sequence: int = ...,
        take: int = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Use Take

        Makes the sequence say a line once, with the chosen take: other takes of it on the timeline are removed with their pause, and a take that is not on the timeline replaces the first one there (linked video and audio, with small handles; what follows moves to fit). "best": true does this for every group whose best take is not already the one heard. Pass the same options as takes.find (and its expectedRevision). One undo step; returns the review list.

        Command ``takes.use`` (needs EditSequence; runs an AI model, so MediaAnalysis is needed too).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            acrossRecordings: Attempts in different recordings count (default true). (Default: True.)
            best: Use the best take of every group ("Keep best takes"). (Default: False.)
            group: The group of takes, 1-based as takes.find lists them (with the same options).
            includeSourceMedia: Also look in the whole recordings the sequence uses, for takes trimmed away (default true). (Default: True.)
            maxGap: Within one recording, attempts further apart than this (seconds) are not retakes (default 180).
            meaning: Also group paraphrased attempts by meaning with the text encoder (slower; default false). (Default: False.)
            media: More media items whose transcripts hold takes.
            minSimilarity: How alike two attempts must be to count as takes of one line, 0.3..1 (default 0.7).
            sequence: The sequence; only needed when the project has several.
            take: The take to use, 1-based (default 1: the best).
            dryRun: Preview the edit without committing it.
            expectedRevision: Fail with StaleRevision unless the project is at this revision.
            idempotencyKey: A repeated call with the same key returns the first result.
        """



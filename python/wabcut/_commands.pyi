class RedactionCommands:

    def add(
        self,
        _params: dict[str, Any] | None = ...,
        /,
        *,
        audio: Literal["none", "mute", "bleep"] = ...,
        clip: int | RedactionAdd_Clip = ...,
        color: list[Any] = ...,
        enabled: bool = ...,
        in_: int | str = ...,
        media: int | str = ...,
        name: str = ...,
        out: int | str = ...,
        region: dict[str, Any] = ...,
        sequence: int = ...,
        source: dict[str, Any] = ...,
        strength: float = ...,
        style: Literal["blur", "mosaic", "solid"] = ...,
        words: list[Any] = ...,
        dryRun: bool = ...,
        expectedRevision: int = ...,
        idempotencyKey: str = ...,
    ) -> Result:
        """Add Redaction

        Marks a region of a media item in SOURCE time for privacy: every use of that range in every sequence (trimmed, sped up, reversed, reused) is blurred, pixelated or covered in preview, export and burn-in, before the clip's own effects; "audio" mutes or bleeps it (only "words" when given). Mark by "media" + "source", or through a "clip" between "in" and "out". The region can be keyframed or tracked (track.mask on a clip's mask, then copied) - its key times are media times. Returns the redaction's id.

        Command ``redaction.add`` (needs EditProject).
        Returns the Result of the edit (``.data`` holds the command's own answer).

        Args:
            _params: The parameters as one dict instead of keywords (a keyword wins); for a name that
                cannot be a keyword.
            audio: What happens to its sound. Default none.
            clip: Or mark through a clip: its media, between "in" and "out". A clip id, or {"track", "time"} for the clip there.
            color: Solid: [r, g, b], 0..1.
            enabled: On or off.
            in_: Sequence time inside the clip where the marked range starts. Timecode in the sequence's rate ("00:01:02:03") or ticks.
            media: The media item (id or exact name).
            name: e.g. "Licence plate".
            out: Sequence time inside the clip where it ends. Timecode in the sequence's rate ("00:01:02:03") or ticks.
            region: The area: {"x", "y", "width", "height", "shape": "rectangle"|"ellipse", "feather"} (0..1 of the frame), or mask fields {"shape", "params", "path", "pathKeys"} (key times are media times). Default a centred ellipse.
            sequence: Sequence id; only needed when the project has several.
            source: {"start", "end"}: the media time it covers (ticks, or a timecode).
            strength: Blur radius or mosaic cell in frame heights. Default 0.05.
            style: Default blur.

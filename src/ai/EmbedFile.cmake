# Embeds a file into a C++ source as a byte array (cmake -P): INPUT, OUTPUT, SYMBOL.
# Defines wabcut::ai::detail::<SYMBOL>[] and <SYMBOL>Size. Used for the model registry (data/models.json), which
# ships inside wabcut_ai so it is always available without file IO.
cmake_minimum_required(VERSION 3.28)

foreach(var INPUT OUTPUT SYMBOL)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "EmbedFile.cmake: ${var} is not set")
    endif()
endforeach()

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hex_length)
math(EXPR size "${hex_length} / 2")
# 32 bytes per line: "0xab,0xcd,..."
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")

file(WRITE "${OUTPUT}.tmp"
"// Generated by src/ai/EmbedFile.cmake from ${INPUT}. Do not edit.
#include <cstddef>

namespace wabcut::ai::detail {
extern const unsigned char ${SYMBOL}[];
extern const std::size_t ${SYMBOL}Size;
const unsigned char ${SYMBOL}[] = {
${bytes}0x00};
const std::size_t ${SYMBOL}Size = ${size};
} // namespace wabcut::ai::detail
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")

# Build-time step (cmake -P): embeds the built-in graphic templates (C.16) into a C++ source file as byte arrays.
# Inputs: -DOUTPUT=<generated .cpp> -DTEMPLATE_DIR=<src/model/templates/builtin>
# Every "*.wabcut-template.json" of the folder is embedded, sorted by file name. The JSON files stay the editable source
# of truth (tests/model/gaming_templates_author.cpp makes them); this file is regenerated whenever they change, and only
# rewritten when its content changes, so dependants are not rebuilt needlessly.

cmake_minimum_required(VERSION 3.28)

foreach(var OUTPUT TEMPLATE_DIR)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "EmbedTemplates.cmake: ${var} is not set")
    endif()
endforeach()

file(GLOB files "${TEMPLATE_DIR}/*.wabcut-template.json")
list(SORT files)

string(REPEAT "0x[0-9a-f][0-9a-f]," 16 row)
set(arrays "")
set(entries "")
set(index 0)
foreach(path IN LISTS files)
    get_filename_component(name "${path}" NAME)
    # File names are template ids plus the suffix: nothing that needs escaping in a C++ string.
    if(NOT name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$")
        message(FATAL_ERROR "EmbedTemplates.cmake: ${path}: a template file name must be <id>.wabcut-template.json")
    endif()
    file(READ "${path}" hex HEX)
    if(hex STREQUAL "")
        message(FATAL_ERROR "EmbedTemplates.cmake: ${path} is empty")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(${row})" "\\1\n    " bytes "${bytes}")
    string(APPEND arrays "constexpr unsigned char kTemplate${index}[] = {\n    ${bytes}\n};\n\n")
    string(APPEND entries "        {\"${name}\", bytesOf(kTemplate${index})},\n")
    math(EXPR index "${index} + 1")
endforeach()

set(content "// Generated by src/model/cmake/EmbedTemplates.cmake from src/model/templates/builtin/*.wabcut-template.json.
// Do not edit: change the JSON files (tests/model/gaming_templates_author.cpp makes them).

#include <cstddef>
#include <string_view>
#include <utility>
#include <vector>

namespace wabcut::detail {
namespace {

${arrays}template <std::size_t N>
std::string_view bytesOf(const unsigned char (&bytes)[N]) {
    return {reinterpret_cast<const char*>(bytes), N};
}

} // namespace

/// The built-in template files (BuiltinTemplates.cpp): file name and bytes, sorted by file name.
std::vector<std::pair<std::string_view, std::string_view>> embeddedTemplateFiles();

std::vector<std::pair<std::string_view, std::string_view>> embeddedTemplateFiles() {
    return {
${entries}    };
}

} // namespace wabcut::detail
")

# Only touch the output when it changes, so dependants are not rebuilt needlessly.
set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()

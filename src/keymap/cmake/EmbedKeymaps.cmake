# Build-time step (cmake -P): embeds the keymap JSON tables into a C++ source file as byte arrays.
# Inputs: -DOUTPUT=<generated .cpp> -DWINDOWS_TABLE=<json> -DMACOS_TABLE=<json>
# The JSON files stay the editable source of truth; this file is regenerated whenever they change.

cmake_minimum_required(VERSION 3.28)

foreach(var OUTPUT WINDOWS_TABLE MACOS_TABLE)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "EmbedKeymaps.cmake: ${var} is not set")
    endif()
endforeach()

# Reads `path` and returns its bytes as "0x..,0x..," text, 16 bytes per line.
function(wabcut_embed_bytes path out_var)
    file(READ "${path}" hex HEX)
    if(hex STREQUAL "")
        message(FATAL_ERROR "EmbedKeymaps.cmake: ${path} is empty")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REPEAT "0x[0-9a-f][0-9a-f]," 16 row)
    string(REGEX REPLACE "(${row})" "\\1\n    " bytes "${bytes}")
    set(${out_var} "${bytes}" PARENT_SCOPE)
endfunction()

wabcut_embed_bytes("${WINDOWS_TABLE}" windows_bytes)
wabcut_embed_bytes("${MACOS_TABLE}" macos_bytes)

set(content "// Generated by src/keymap/cmake/EmbedKeymaps.cmake from src/keymap/keymaps/*.json. Do not edit.

#include \"EmbeddedKeymaps.h\"

namespace wabcut::keymap::detail {
namespace {

constexpr unsigned char kPremiereWindows[] = {
    ${windows_bytes}
};

constexpr unsigned char kPremiereMacos[] = {
    ${macos_bytes}
};

} // namespace

std::string_view premiereWindowsJson() {
    return {reinterpret_cast<const char*>(kPremiereWindows), sizeof(kPremiereWindows)};
}

std::string_view premiereMacosJson() {
    return {reinterpret_cast<const char*>(kPremiereMacos), sizeof(kPremiereMacos)};
}

} // namespace wabcut::keymap::detail
")

# Only touch the output when it changes, so dependants are not rebuilt needlessly.
set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
